# Fata Morgana town ID (the number in your town's Fata link, e.g. 7316)
# e.g. https://beta.fatamorgana.md26.eu/map/{YOUR_TOWN_ID}
# Fallback only: a town ID in towns/_current_town wins, and is re-read on every call.
FATAMORGANA_TOWN_ID=

# Optional: your in-game name, so reports can single you out
# PLAYER_NAME=

# Optional: contact added to the User-Agent sent to Fata / Gest'Hordes (e.g. your MyHordes name)
# so their admins can reach you about your traffic. An anonymous random install ID is always sent.
# MCP_CONTACT=

# Optional: seconds a Fata response stays cached in memory (default 180, 0 = off).
# Concurrent tool calls always share one request regardless.
# FATA_CACHE_TTL=180

# Optional: automatic town log (towns/<town>/daily-log.md, day-NN.md) on every live fetch.
# 1 = on (default), 0 = off. With two machines sharing towns/ via git, enable it on one only.
# TOWN_LOG_AUTO=1
# Minutes between two automatic "Check" entries in the day file (default 60).
# TOWN_LOG_INTERVAL=60
# FATA_TOWNDATA_URL=https://beta.fatamorgana.md26.eu/towndata
# GESTHORDES_CACHE_TTL=120

# Official MyHordes API — currently DISABLED (see src/myhordes_mcp/myhordes/official_api.py)
# MYHORDES_USER_KEY=your_external_id_here
# MYHORDES_APP_KEY=your_app_secret_here

# Wiki scraper cookies (from browser DevTools → Cookies → en.mhwiki.org)
# Needed to bypass Cloudflare when running fetch_wiki.py
MHWIKI_CF_CLEARANCE=your_cf_clearance_cookie_here
MHWIKI_SESSION=your_mhwiki_session_here
MHWIKI_TOKEN=your_mhwikiToken_here
# Optional: logged-in wiki user cookies (mhwikiUserName / mhwikiUserID)
# MHWIKI_USER_NAME=
# MHWIKI_USER_ID=
